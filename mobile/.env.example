# Mobile apps configuration.
# Copy to mobile/.env and set the laptop's LAN IP (NEVER localhost on a phone).
# The phone must be on the same Wi-Fi network as the laptop.
VITE_API_BASE_URL=http://192.168.1.10:5000/api

# For `npm run dev` on the laptop only (proxies /api and /uploads):
VITE_DEV_PROXY=http://127.0.0.1:5000
