# Command-center frontend configuration.
# Copy to frontend/.env and set the laptop's LAN IP (ipconfig -> IPv4 Address).
# Never use localhost here when other devices must reach this app.
VITE_API_BASE_URL=http://192.168.1.10:5000/api

# Optional: where `npm run dev` proxies /api and /uploads to (laptop only).
VITE_DEV_PROXY=http://127.0.0.1:5000
