# ---- BhuRaksha backend environment (copy to backend/.env or set in shell) ----

# Flask server
BHURAKSHA_HOST=0.0.0.0
BHURAKSHA_PORT=5000
BHURAKSHA_DEBUG=0

# Security
BHURAKSHA_SECRET_KEY=change-me-to-a-long-random-string
BHURAKSHA_TOKEN_TTL_HOURS=72

# Storage
BHURAKSHA_DB_PATH=backend/data/bhuraksha.db
BHURAKSHA_UPLOAD_DIR=backend/data/uploads
BHURAKSHA_TILE_CACHE_DIR=backend/data/tiles/cache

# CORS: comma separated origins, or * for a LAN demo
BHURAKSHA_CORS_ORIGINS=*

# When set, the tile proxy will not fetch missing tiles from OpenStreetMap
BHURAKSHA_TILE_OFFLINE=0

# ---- Frontend (frontend/.env and mobile/.env) ----
# Point this at the laptop's LAN IP so phones on the same Wi-Fi can reach it.
# NEVER use localhost for mobile clients.
# VITE_API_BASE_URL=http://192.168.1.10:5000/api
